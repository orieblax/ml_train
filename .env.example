# AWS Region & Scoped Credentials (from `infra/scripts/print-env.py` or `infra/scripts/deploy.py`)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Provisioned AWS Resources (Free-Tier Stack)
MLTRAIN_S3_BUCKET=
# Serverless Framework default stage uses `mltrain-prod-workspace`; standalone CloudFormation uses `mltrain-workspace`
MLTRAIN_DDB_TABLE=mltrain-prod-workspace
MLTRAIN_TRAINER_LAMBDA_ARN=
MLTRAIN_ML_LAYER_ARN=
MLTRAIN_INFERENCE_ROLE_ARN=

# Security (Login Screen & API Key Encryption)
# Generate MLTRAIN_SESSION_SECRET with: openssl rand -hex 32 (auto-generated by print-env.py)
MLTRAIN_SESSION_SECRET=
# Login screen credentials stored in Vercel Environment Variables (required to sign in)
APP_USERNAME=admin
APP_PASSWORD=
