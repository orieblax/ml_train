# AWS Region & Scoped Credentials (from infra/scripts/deploy.py output)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Provisioned AWS Resources (Free-Tier Stack)
MLTRAIN_S3_BUCKET=
MLTRAIN_DDB_TABLE=mltrain-workspace
MLTRAIN_TRAINER_LAMBDA_ARN=
MLTRAIN_ML_LAYER_ARN=
MLTRAIN_INFERENCE_ROLE_ARN=

# Security (Workspace Access & API Key Encryption)
# Generate MLTRAIN_SESSION_SECRET with: openssl rand -hex 32
MLTRAIN_SESSION_SECRET=
# Optional passcode to gate access to the studio UI & API routes
APP_ACCESS_PIN=
