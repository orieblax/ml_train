{
  "name": "ml_train",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sls:build": "node infra/scripts/run-python.mjs infra/scripts/package_lambdas.py",
    "sls:package": "npx --yes serverless@3 package --stage prod",
    "sls:deploy": "npm run sls:build && npx --yes serverless@3 deploy --stage prod",
    "sls:deploy:local": "npm run sls:build && node infra/scripts/sls-with-profile.mjs deploy --profile test_local --stage prod",
    "sls:env:local": "node infra/scripts/run-python.mjs infra/scripts/print-env.py --stage prod --profile test_local --create-access-key",
    "sls:remove": "npx --yes serverless@3 remove --stage prod",
    "sls:remove:local": "node infra/scripts/sls-with-profile.mjs remove --profile test_local --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-lambda": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "papaparse": "^5.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
